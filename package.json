    "@opencode-ai/sdk": "^1.0.0",
    "@opencode-ai/plugin": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "bun-types": "^1.0.21",
    "esbuild": "^0.20.2",
    "typescript": "^5.4.5",
    "vitest": "^4.1.1"
  }
