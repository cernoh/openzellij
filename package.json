{
  "name": "openzellij",
  "version": "1.0.0",
  "description": "OpenCode plugin for Zellij integration",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "node ./scripts/build.js",
    "dev": "node ./scripts/build.js --watch",
    "typecheck": "tsc --noEmit",
